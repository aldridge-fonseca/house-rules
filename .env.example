# House Rules environment variables — copy to .env and fill in real values.
# .env is gitignored; never commit secrets.

# ---- Fireworks AI (eval, training, deployments) ----
FIREWORKS_API_KEY=
FIREWORKS_ACCOUNT_ID=
FIREWORKS_MODEL=                  # tuned deployment path: accounts/<acct>/deployments/<id>
FIREWORKS_SERVERLESS_MODEL=       # serverless model path for smoke checks
FIREWORKS_TEXT_MODEL=             # text-only VLM A/B arm (default: Nemotron Lightning 3.5 30B)
FIREWORKS_VISION_MODEL=           # vision deployment path (created by scripts/vision_deploy.sh)
FIREWORKS_SYSTEMONE_MODEL=        # override for the default chat model
FIREWORKS_REASONING_EFFORT=       # e.g. none / low / high
FIREWORKS_COST_USD_PER_REQUEST=   # flat per-request cost override
FIREWORKS_PRICE_INPUT_PER_MILLION_USD=
FIREWORKS_PRICE_OUTPUT_PER_MILLION_USD=
FIREWORKS_VISION_RATE_USD_PER_HOUR=  # on-demand vision deployment GPU rate

# ---- Frontier baselines (direct providers + OpenAI-compatible token router) ----
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
ROUTER_API_KEY=
ROUTER_BASE_URL=
FRONTIER_MODEL=                   # default router arm model
FRONTIER_MODEL_A=                 # frontier-router-a model
FRONTIER_MODEL_B=                 # frontier-router-b model
FRONTIER_ROUTER_RESERVE_USD=      # budget reserve for router arms
HF_TOKEN=                         # gated Hugging Face dataset downloads

# ---- Tuned-model eval ladder (scripts/nano_ladder.py) ----
NANO_BASE_MODEL=                  # untuned base deployment for the ablation arm
NANO_ESCALATION=                  # escalation deployment override

# ---- Budget / spend ledger ----
SAFETY_ONE_BUDGET_GLOBAL_USD=
SAFETY_ONE_BUDGET_FIREWORKS_USD=
SAFETY_ONE_BUDGET_FRONTIER_USD=
SAFETY_ONE_SPEND_FILE=            # default: results/spend.json
SAFETY_ONE_NO_DOTENV=             # set to skip .env autoload (tests set this)

# ---- Demo ----
FRONTIER_PROVIDER=                # frontier lane provider (default: gemini)
DEMO_LIVE_FRONTIER=               # set to 1 to run the frontier lane live

# ---- Testing only ----
FW_TEST_KEY=                      # fake key injected by mocked-HTTP tests
